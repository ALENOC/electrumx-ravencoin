# Non-secret Compose settings. setup.sh copies this to .env without overwriting.
ELECTRUMX_CACHE_MB=1200

# Bundled-Core readiness thresholds used to gate ElectrumX startup after boot.
# The node must be within this many blocks of its best known headers.
RAVENCOIN_HEALTH_MAX_BLOCK_LAG=2
# Maximum accepted age of the current best block, in seconds.
RAVENCOIN_HEALTH_MAX_TIP_AGE=1800
# Require at least this many Ravencoin P2P peers before Core is "ready".
RAVENCOIN_HEALTH_MIN_PEERS=1

# Required only when compose.tls.yaml or compose.existing-core.yaml is used.
ELECTRUMX_PUBLIC_HOST=electrum.example.org
ELECTRUMX_TLS_DIRECTORY=/etc/letsencrypt/live/electrum.example.org
ELECTRUMX_ENV_FILE=contrib/electrumx.env
