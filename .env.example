# Non-secret Compose settings. setup.sh copies this to .env without overwriting.
ELECTRUMX_CACHE_MB=1200

# Required only when compose.tls.yaml or compose.existing-core.yaml is used.
ELECTRUMX_PUBLIC_HOST=electrum.example.org
ELECTRUMX_TLS_DIRECTORY=/etc/letsencrypt/live/electrum.example.org
ELECTRUMX_ENV_FILE=contrib/electrumx.env
