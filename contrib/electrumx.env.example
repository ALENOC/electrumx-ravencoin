# Existing-Core mode only. Copy to contrib/electrumx.env, chmod 600, and replace
# every CHANGE_ME value. Never commit it. Core RPC must remain loopback/private.
DAEMON_URL=http://CHANGE_ME_RPC_USER:CHANGE_ME_RPC_PASSWORD@127.0.0.1:8766/
REPORT_SERVICES=ssl://electrum.example.org:50002
SSL_CERTFILE=/run/electrumx/tls/fullchain.pem
SSL_KEYFILE=/run/electrumx/tls/privkey.pem

# Safe production baseline. Do not set ALLOW_UNSAFE_RAVENCOIN_CORE.
NET=mainnet
CACHE_MB=1200
SERVICES=ssl://:50002,rpc://127.0.0.1:8000
RAVENCOIN_BACKEND_CHECK_INTERVAL=60
RAVENCOIN_BACKEND_INFO_MAX_AGE=5

# Backend identity, optional and honest by default.
#
# Leave these unset and the server publishes identityEvidence=VERSION_ONLY: it
# reports only what the daemon says about itself, which is all a third-party
# deployment can actually prove over JSON.
#
# Set them only if you personally know which source your Core was built from.
# The result is published as BUILD_IDENTITY_ATTESTED, meaning "the operator says
# so", never as proof. BUILD_IDENTITY_VERIFIED is reserved for the bundled
# deployment, which pins and digest-checks the artifact at image build time.
#
# RAVENCOIN_SOURCE_REPOSITORY=RavenProject/Ravencoin
# RAVENCOIN_SOURCE_TAG=v4.8.0
# RAVENCOIN_SOURCE_COMMIT=22549129888d02e0e08fcdb9f96f3c699167e774
