# Copy to contrib/electrumx.env, chmod 600, and replace every CHANGE_ME value.
# Never commit the resulting file. Core RPC must remain loopback/private.
DAEMON_URL=http://CHANGE_ME_RPC_USER:CHANGE_ME_RPC_PASSWORD@127.0.0.1:8766/
REPORT_SERVICES=ssl://electrum.example.org:50002
SSL_CERTFILE=/run/electrumx/tls/fullchain.pem
SSL_KEYFILE=/run/electrumx/tls/privkey.pem

# Safe production baseline. Do not set ALLOW_UNSAFE_RAVENCOIN_CORE.
NET=mainnet
CACHE_MB=1200
RAVENCOIN_BACKEND_CHECK_INTERVAL=60
RAVENCOIN_BACKEND_INFO_MAX_AGE=5
